# MongoDB Connection URI (Local or Atlas)
# In development, leave blank or use localhost.
# For Atlas in production, define in your private .env.local or platform env variables:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pitchconnect

# JWT Authentication Secret
JWT_SECRET=pitchconnect-super-secure-jwt-secret-minimum-32-chars

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PitchConnect
