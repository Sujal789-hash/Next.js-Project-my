# ================================================================
# PitchConnect - Environment Variables
# Copy values from your own secret store. Never commit real secrets.
# ================================================================

# Required. MongoDB Atlas connection URI including a dedicated database name.
# Do not use localhost in production. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Required. Random 32+ character secret used to sign JWTs.
JWT_SECRET=<generate-a-random-secret-of-at-least-32-characters>

# Optional. Documented for convenience; not currently read by the application code.
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_APP_NAME=PitchConnect

# Local seed script only. Set to 1 to allow `npm run seed` in development.
# PITCHCONNECT_ALLOW_SEED=1

# One-time admin bootstrap (terminal only). See docs/admin-bootstrap.md.
# Never store real values here; supply them in the shell session that runs the script.
# ADMIN_BOOTSTRAP=1
# ADMIN_BOOTSTRAP_CONFIRM_DB=<exact-database-name-from-MONGODB_URI>
# ADMIN_BOOTSTRAP_FULL_NAME=<admin-full-name>
# ADMIN_BOOTSTRAP_EMAIL=<admin-email>
# ADMIN_BOOTSTRAP_PASSWORD=<strong-password>
# ADMIN_BOOTSTRAP_PHONE=<optional-phone>
# ADMIN_BOOTSTRAP_DRY_RUN=1
