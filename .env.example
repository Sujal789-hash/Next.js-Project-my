# ================================================================
# PitchConnect - Environment Configuration
# ================================================================

# MongoDB Connection URI (Local or Atlas)
# In development, leave blank or use localhost.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pitchconnect

# JWT Authentication Secret
JWT_SECRET=pitchconnect-super-secure-jwt-secret-minimum-32-chars

# Public App URL & Name
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PitchConnect

# ================================================================
# OAuth 2.0 Provider Credentials
# ================================================================

# 1. Google OAuth 2.0
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# Application type: Web application
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 2. GitHub OAuth 2.0
# Obtain from: GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 3. Facebook OAuth 2.0
# Obtain from: Meta for Developers -> My Apps -> Create App -> Set up Facebook Login
# Valid OAuth Redirect URIs: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
